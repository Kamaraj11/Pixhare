# ─────────────────────────────────────────────────────────────────────
# .env.example — Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to git.
# ─────────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=replace-with-a-long-random-string

# ── Application base URL (used in gallery email links) ────────────────
# Set this to your real domain in production, e.g. https://pixhare.com
BASE_URL=http://127.0.0.1:5000

# ── Database (optional — defaults to local SQLite) ────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/pixhare

# ── AI Pipeline ───────────────────────────────────────────────────────
FACE_DETECTION_BACKEND=retinaface
FACE_RECOGNITION_MODEL=ArcFace
FACE_CONFIDENCE_THRESHOLD=0.85
FAISS_TOP_K=10
SIMILARITY_THRESHOLD=0.40

# ── LLM / RAG (optional — system works without this) ──────────────────
# Supported providers: groq | openai | none
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your-groq-or-openai-api-key-here
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2

# ── Voice / Speech-to-Text (optional) ────────────────────────────────
# Supported providers: groq_whisper | none
STT_PROVIDER=groq_whisper

# ── SMTP Email (optional — email delivery disabled if not set) ────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=your-email@gmail.com

# ── QR / Session ──────────────────────────────────────────────────────
SESSION_LIFETIME_MINUTES=60
